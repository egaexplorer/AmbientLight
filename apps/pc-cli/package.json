{
  "name": "@ambientlight/pc-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line PC screen sync for Philips WiZ bulbs (Phases 1–3): screenshot-desktop + sharp capture, node:dgram UDP.",
  "type": "module",
  "bin": {
    "ambientlight": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -b"
  },
  "dependencies": {
    "@ambientlight/core": "*",
    "screenshot-desktop": "^1.15.1",
    "sharp": "^0.35.4"
  }
}
