{
  "name": "ambientlight",
  "version": "0.1.0",
  "private": true,
  "description": "Sync Philips WiZ smart bulbs to the colors on your PC or Android screen. TypeScript monorepo.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/node",
    "apps/pc-cli",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @ambientlight/desktop",
    "clean": "tsc -b --clean",
    "test": "tsx --conditions=development --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.tests.json && npm run typecheck -w @ambientlight/desktop",
    "check": "npm run build && npm run typecheck && npm test",
    "desktop": "npm run dev -w @ambientlight/desktop",
    "help": "npm run dev -w @ambientlight/pc-cli -- help",
    "discover": "npm run dev -w @ambientlight/pc-cli -- discover",
    "check-bulb": "npm run dev -w @ambientlight/pc-cli -- check",
    "state": "npm run dev -w @ambientlight/pc-cli -- state",
    "on": "npm run dev -w @ambientlight/pc-cli -- on",
    "off": "npm run dev -w @ambientlight/pc-cli -- off",
    "displays": "npm run dev -w @ambientlight/pc-cli -- displays",
    "color": "npm run dev -w @ambientlight/pc-cli -- color",
    "once": "npm run dev -w @ambientlight/pc-cli -- once",
    "sync": "npm run dev -w @ambientlight/pc-cli -- sync",
    "rain": "npm run dev -w @ambientlight/pc-cli -- rain"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
